<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar usuário #<%= usuario.id %> | The Iron Legacy</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="header">
        <div class="wrap flex-between">
            <div>
                <a class="logo" href="/">THE IRON <span>LEGACY</span></a>
                <span class="badge-adm">ADMIN</span>
            </div>
            <nav class="nav">
                <a href="/adm">Painel</a>
                <a href="/logout">Sair</a>
            </nav>
        </div>
    </header>

    <main class="wrap main-adm">
        <a class="back" href="/adm" style="color:#777;">&larr; Voltar para o painel</a>

        <div class="adm-top">
            <div>
                <p class="eyebrow">EDITAR USUÁRIO</p>
                <h1>Usuário #<%= usuario.id %></h1>
            </div>
        </div>

        <section class="panel" style="max-width:640px;">
            <form method="POST" action="/usuarios/<%= usuario.id %>/editar">
                <div class="grid">
                    <div class="input-container">
                        <label for="nome">Nome completo</label>
                        <input id="nome" type="text" name="nome" value="<%= usuario.nome %>" required>
                    </div>

                    <div class="input-container">
                        <label for="telefone">Telefone</label>
                        <input id="telefone" type="tel" name="telefone" value="<%= usuario.telefone %>" required>
                    </div>
                </div>

                <br>

                <div class="input-container">
                    <label for="email">E-mail</label>
                    <input id="email" type="email" name="email" value="<%= usuario.email %>" required>
                </div>

                <br>

                <div class="input-container">
                    <label for="senha">Nova senha</label>
                    <input id="senha" type="password" name="senha" minlength="6" autocomplete="new-password" placeholder="Deixe em branco para manter a atual">
                </div>

                <div style="display:flex; gap:12px; margin-top:28px;">
                    <button type="submit" class="button primary">Salvar alterações</button>
                    <a class="button secondary" href="/adm">Cancelar</a>
                </div>
            </form>
        </section>
    </main>
    <script src="/rodape.js"></script>
</body>
</html>